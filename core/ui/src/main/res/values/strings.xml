<?xml version="1.0" encoding="utf-8"?>
<!-- Wording more than one screen uses. -->
<resources>
    <string name="core_ui_try_again">Try again</string>

    <!-- What a place with no name is called, as a point picked off the map:
         "35.60°N, 82.55°W". %1$s is place_north or place_south, %2$s is
         place_east or place_west; each of those takes degrees such as "35.60". -->
    <string name="core_ui_place_coordinates">%1$s, %2$s</string>
    <string name="core_ui_place_north">%1$s°N</string>
    <string name="core_ui_place_south">%1$s°S</string>
    <string name="core_ui_place_east">%1$s°E</string>
    <string name="core_ui_place_west">%1$s°W</string>

    <!-- Temperatures and speeds. %1$d is a whole number. -->
    <string name="core_ui_temperature">%1$d°</string>
    <string name="core_ui_temperature_celsius">%1$d°C</string>
    <string name="core_ui_temperature_fahrenheit">%1$d°F</string>
    <string name="core_ui_speed_kmh">%1$d km/h</string>
    <string name="core_ui_speed_mph">%1$d mph</string>
    <!-- A temperature as a screen reader says it. -->
    <plurals name="core_ui_spoken_celsius">
        <item quantity="one">%1$d degree Celsius</item>
        <item quantity="other">%1$d degrees Celsius</item>
    </plurals>
    <plurals name="core_ui_spoken_fahrenheit">
        <item quantity="one">%1$d degree Fahrenheit</item>
        <item quantity="other">%1$d degrees Fahrenheit</item>
    </plurals>

    <!-- Weather conditions -->
    <string name="core_ui_condition_clear">Clear</string>
    <string name="core_ui_condition_mostly_clear">Mostly clear</string>
    <string name="core_ui_condition_partly_cloudy">Partly cloudy</string>
    <string name="core_ui_condition_overcast">Overcast</string>
    <string name="core_ui_condition_fog">Fog</string>
    <string name="core_ui_condition_drizzle">Drizzle</string>
    <string name="core_ui_condition_freezing_drizzle">Freezing drizzle</string>
    <string name="core_ui_condition_rain">Rain</string>
    <string name="core_ui_condition_freezing_rain">Freezing rain</string>
    <string name="core_ui_condition_snow">Snow</string>
    <string name="core_ui_condition_rain_showers">Rain showers</string>
    <string name="core_ui_condition_snow_showers">Snow showers</string>
    <string name="core_ui_condition_thunderstorm">Thunderstorm</string>
    <string name="core_ui_condition_unknown">Unknown</string>

    <!-- What went wrong -->
    <string name="core_ui_failure_timeout">The weather service took too long to answer.</string>
    <string name="core_ui_failure_no_connection">Could not reach the weather service. Check your connection.</string>
    <string name="core_ui_failure_bad_response">The weather service sent an answer this app could not read.</string>
    <string name="core_ui_failure_rejected">The weather service refused the request.</string>
    <string name="core_ui_failure_unavailable">The weather service is having trouble. Try again in a moment.</string>
    <string name="core_ui_failure_invalid_place">That point is not on the map.</string>
</resources>
